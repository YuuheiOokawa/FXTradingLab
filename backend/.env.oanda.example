# =============================================================================
# OANDA practice — real market data, virtual money.
#
# Copy the values you need into backend/.env, then verify with:
#     cd backend && python -m scripts.check_oanda
#
# This switches the app from the built-in simulator (a seeded random walk, which
# tells you nothing about a strategy) to real prices. Forward-test results only
# mean something once this is in place.
# =============================================================================

APP_ENV=development

# --- Broker: real prices, practice (virtual) account -------------------------
BROKER_PROVIDER=oanda
OANDA_API_TOKEN=          # from OANDA: Manage API Access -> Generate
OANDA_ACCOUNT_ID=         # looks like 101-001-1234567-001
OANDA_ENVIRONMENT=practice

# MARKET_DATA_PROVIDER is intentionally ABSENT, not blank: it is an optional
# Literal, and an empty string fails startup validation. Leave the key out.
# MARKET_DATA_PROVIDER=

# --- LIVE trading: stays OFF ---------------------------------------------
# Real-money execution IS implemented (OrderOrchestrator.submit_live_order) but
# is reachable ONLY through the manual POST /api/v1/live/orders endpoint with an
# explicit per-request confirmation. No automatic loop can call it — the
# auto-trader submits PAPER orders exclusively, and tests/test_live_execution.py
# fails if that ever changes.
#
# Turning this on is one of THREE required gates (env + admin setting +
# per-order confirmation). Leave it false while forward-testing.
LIVE_TRADING_ENABLED=false

# --- Local infrastructure ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fxlab:fxlab@localhost:5432/fxlab
REDIS_URL=redis://localhost:6379/0

DEFAULT_WATCHLIST=USD_JPY,EUR_JPY,GBP_JPY,EUR_USD
POLL_INTERVAL_MS=2000
PRICE_STALE_SECONDS=10
LOG_LEVEL=INFO
LOG_FORMAT=text
