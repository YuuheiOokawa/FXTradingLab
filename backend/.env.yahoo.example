# =============================================================================
# Real market data with NO broker account and NO identity verification.
#
# Copy into backend/.env, restart the app, and the prices become real. Verify
# with:  cd backend && python -m scripts.check_market_data
#
# This is the recommended way to start forward testing: the built-in simulator
# is a seeded random walk, so results against it mean nothing, while opening a
# broker account (even a demo one) can require submitting ID documents.
# =============================================================================

APP_ENV=development

# --- Prices: real, from Yahoo Finance -----------------------------------------
# Market data and order execution are configured separately. Prices come from
# Yahoo; orders stay on the built-in paper simulator, which never contacts any
# broker. Setting BROKER_PROVIDER=yahoo instead is refused at startup — Yahoo
# is not a broker and cannot execute anything.
MARKET_DATA_PROVIDER=yahoo
BROKER_PROVIDER=mock

# What this costs you, honestly:
#   * Unofficial endpoint — no uptime guarantee, can change without notice.
#     Fine for personal research; not something to run real money against.
#   * Delayed, and Yahoo publishes one price rather than a bid/ask. The adapter
#     synthesises a 1.5-pip spread so cost logic behaves sanely, but a real
#     broker's spread will differ, especially around news.
#   * Daily bars are the honest use, which is exactly what the playbook needs.
#
# When you do open a broker account, switch BOTH lines to that broker so the
# prices you trade on are the prices you were tested against.

# --- LIVE trading: stays off --------------------------------------------------
# Real-money execution is implemented but reachable only through the manual
# endpoint with three gates open. No automatic loop can call it.
LIVE_TRADING_ENABLED=false

# --- Local infrastructure -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fxlab:fxlab@localhost:5432/fxlab
REDIS_URL=redis://localhost:6379/0

DEFAULT_WATCHLIST=USD_JPY,EUR_JPY,GBP_JPY,EUR_USD

# Yahoo has no push feed, so prices are polled. 5s is gentle on an unofficial
# endpoint and plenty for a daily strategy.
POLL_INTERVAL_MS=5000

# Measured: Yahoo's FX quote timestamp tracks real time (~2s old), so the 10s
# default mostly works. Raised modestly only to absorb a slow poll — not high
# enough to let a genuinely dead feed through.
#
# Note the Risk Engine refuses to trade on a stale price. Over the weekend the
# FX market is shut and Yahoo keeps returning Friday's close, which will read as
# stale and block orders. That is correct behaviour, not a misconfiguration.
PRICE_STALE_SECONDS=120

LOG_LEVEL=INFO
LOG_FORMAT=text
