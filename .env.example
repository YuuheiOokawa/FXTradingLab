# =============================================================================
# FX Trading Lab — environment variables
# Copy to .env for docker-compose, or into backend/.env for running the backend
# directly. NEVER commit a real .env file — secrets only ever live here as
# placeholders (docs/11_SECURITY.md).
# =============================================================================

# --- App ---
APP_ENV=development
# Required (non-development only): a long random string. The backend rejects
# every /api/v1/* request without a matching `Authorization: Bearer <token>`,
# and every WebSocket connection without a valid short-lived ticket minted
# via that same auth (docs/11_SECURITY.md "BFF migration"). The BROWSER never
# holds or sends this value directly anymore — it's held only server-side by
# the frontend's BFF proxy (frontend/.env.local's BACKEND_API_TOKEN, which
# must be set to this exact same value) and, by default, doubles as the
# password an operator types into /login (frontend/.env.local's own
# APP_API_TOKEN — docker-compose.yml wires both to this one value for
# simplicity; set the frontend's copy to something different instead if you
# want the login password and backend token to be independently rotatable).
APP_API_TOKEN=
# Required alongside APP_API_TOKEN (non-development only): a separate long
# random string used only to sign the frontend's session cookie
# (frontend/src/lib/session.ts) — never shared with the backend, never sent
# anywhere, just needs to exist so a session cookie can be verified.
SESSION_SECRET=
# Comma-separated browser origins allowed to call the API in non-development
# environments, e.g. https://fxlab.example.com. Leave blank for a same-origin
# deployment (frontend and backend behind one reverse-proxy domain).
ALLOWED_ORIGINS=
# Per-identity (bearer token, or client IP if auth is disabled) requests-per-
# minute cap on /api/v1/* in non-development environments. See
# docs/11_SECURITY.md "Rate limiting".
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
# text (human-readable, default — good for local dev) | json (structured,
# one JSON object per line with request_id/order_id correlation fields — use
# this in real deployments so a log aggregator can parse it).
LOG_FORMAT=text
SERVICE_NAME=fx-trading-lab

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fxlab:fxlab@postgres:5432/fxlab

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Broker selection (docs/06_BROKER_API_DESIGN.md) ---
# mock (default, no credentials needed) | oanda | gmo_coin (stub, not implemented)
# Used for BOTH market data and trading unless MARKET_DATA_PROVIDER overrides it.
BROKER_PROVIDER=mock
BROKER_ENVIRONMENT=practice
# Optional: use a different provider for price data than for order execution
# (docs/15_PRODUCTION_READINESS_REVIEW.md "BrokerAdapter split"). Leave unset
# unless you specifically need this — a mismatch risks spread/latency skew
# between displayed and tradeable prices, and symbol-mapping errors. The app
# logs a warning at startup and shows a banner on the System page if set.
MARKET_DATA_PROVIDER=

# OANDA v20 API — practice accounts are free to create at developer.oanda.com.
# Leave blank to use the built-in MockAdapter instead.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# GMO Coin (docs/06_BROKER_API_DESIGN.md — recommended real path to a JP-resident
# LIVE account, adapter not yet implemented; left here for when it is)
GMO_COIN_API_KEY=
GMO_COIN_API_SECRET=

# --- Market data ---
POLL_INTERVAL_MS=2000
PRICE_STALE_SECONDS=10
TICK_RETENTION_DAYS=7
CANDLE_1M_RETENTION_DAYS=90
DEFAULT_WATCHLIST=USD_JPY,EUR_JPY,GBP_JPY,EUR_USD

# --- LIVE trading gate (docs/10_RISK_MANAGEMENT.md) ---
# MUST stay false unless you deliberately intend to place real-money orders, and
# even then this is only ONE of three required gates (env var + admin setting +
# per-order confirmation). Never set this to true in a shared/production
# deployment's default config.
LIVE_TRADING_ENABLED=false

# --- AI (optional — the app works fully without this; templated summaries are
# used instead of LLM-generated ones, docs/08_SIGNAL_ENGINE.md) ---
AI_API_KEY=
AI_PROVIDER=anthropic

# --- Notifications (future channels; only in_app is implemented today) ---
DISCORD_WEBHOOK_URL=
LINE_NOTIFY_TOKEN=

# --- Frontend: browser-visible (no secrets — see frontend/.env.local.example
# for the full set, including the server-only ones that replace the old
# NEXT_PUBLIC_APP_API_TOKEN) ---
# Public origin the BROWSER connects its WebSocket to directly (not proxied
# through Next.js — see docs/11_SECURITY.md "BFF migration"). Not a secret,
# just a hostname; per-connection auth is a short-lived ticket, not this URL.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Postgres container (docker-compose only) ---
POSTGRES_USER=fxlab
POSTGRES_PASSWORD=fxlab
POSTGRES_DB=fxlab
