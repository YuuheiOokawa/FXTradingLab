# Base URL of the FastAPI backend (browser-visible; no secrets here — see
# docs/11_SECURITY.md, broker tokens never reach the frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only needed if the backend has APP_API_TOKEN set (non-development environments).
# This value IS shipped to the browser (used by lib/api.ts to call the backend
# API/WebSocket directly) — that's unavoidable in this architecture, but it's
# only ever visible to someone who has already authenticated (see below).
NEXT_PUBLIC_APP_API_TOKEN=

# Same value as NEXT_PUBLIC_APP_API_TOKEN above and as the backend's
# APP_API_TOKEN, but WITHOUT the NEXT_PUBLIC_ prefix — this copy is read only
# server-side (middleware.ts, app/api/session-login/route.ts) and is never
# inlined into any file the browser downloads. This is what actually gates
# the login page and every other route — see docs/11_SECURITY.md "Frontend
# login gate" for why the login check must use this one, not the
# NEXT_PUBLIC_ copy.
APP_API_TOKEN=
