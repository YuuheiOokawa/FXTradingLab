# === Browser-visible (no secrets) ===

# Public origin the BROWSER's WebSocket connects to directly for live prices
# (docs/11_SECURITY.md "BFF migration" — REST goes through this app's own
# /api/backend/* proxy instead, so it needs no public backend URL at all).
# Not a secret, just a hostname; per-connection auth is a short-lived ticket
# obtained from /api/ws-ticket, never a credential in this URL.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# === Server-only (never sent to the browser) ===

# The password an operator types into /login. Required only in non-development
# deployments (leave unset locally to skip the login gate entirely). Simplest
# setup: the same value as the backend's APP_API_TOKEN (docker-compose.yml
# does this by default). For independently rotatable secrets, set this to a
# different value than BACKEND_API_TOKEN below — nothing else needs to change.
APP_API_TOKEN=

# HMAC key used to sign the session cookie minted on successful login
# (lib/session.ts). Required whenever APP_API_TOKEN is set. A leaked session
# cookie is useless without this to have signed it, and this never appears in
# any cookie value itself.
SESSION_SECRET=

# Must match the backend's APP_API_TOKEN exactly — this is what
# app/api/backend/[...path]/route.ts and app/api/ws-ticket/route.ts send as
# `Authorization: Bearer <token>` when calling FastAPI server-to-server. The
# browser never sees this value under any circumstances.
BACKEND_API_TOKEN=

# Where the Next.js SERVER reaches FastAPI — may differ from the backend's
# public URL (e.g. a Railway private-network hostname that's unreachable
# from the public internet at all, which is preferable when available: see
# docs/17_PRODUCTION_DEPLOYMENT_GUIDE.md "Railway private networking").
BACKEND_INTERNAL_URL=http://localhost:8000
